POSTGRES_USER=buyflow
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
POSTGRES_DB=buyflow_n8n
N8N_ENCRYPTION_KEY=CHANGE_ME_LONG_RANDOM_ENCRYPTION_KEY
N8N_USER_MANAGEMENT_JWT_SECRET=CHANGE_ME_LONG_RANDOM_JWT_SECRET

# Existing Windows Ollama. n8n runs in Docker and reaches the host through this URL.
BUYFLOW_OLLAMA_URL=http://host.docker.internal:11434/api/chat
BUYFLOW_OLLAMA_MODEL=qwen3:8b

# Phase 1 is shadow/read-only. The AI returns a decision but cannot mutate BuyFlow.
BUYFLOW_AI_EXECUTE=false
