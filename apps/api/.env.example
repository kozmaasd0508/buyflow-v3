PORT=3000
HOST=0.0.0.0

SUPABASE_URL=
# Preferred server-side key for new Supabase projects (sb_secret_...).
SUPABASE_SECRET_KEY=
# Legacy fallback only; do not use for new deployments if a secret key is available.
SUPABASE_SERVICE_ROLE_KEY=

NYLAS_API_KEY=
NYLAS_API_URI=https://api.eu.nylas.com
# Development-only single-account smoke test. Production grant IDs live in email_connections.provider_account_id.
NYLAS_SMOKE_GRANT_ID=

# Mailgun inbound route authentication. Use the account Webhook Signing Key, never the API key.
MAILGUN_WEBHOOK_SIGNING_KEY=

# Gate B: read-only GREEN protocol observation on live Nylas message.created events.
# Set false as an immediate operational kill switch; it never enables protocol writes.
BUYFLOW_PROTOCOL_PRODUCTION_SHADOW_ENABLED=true

# EventMind V11 stays OFF until a new untouched MailLens/EventMind representation
# gate passes. Enabling requires the exact local V11 adapter SHA-256; never guess it.
BUYFLOW_EVENTMIND_V11_RUNTIME_ENABLED=false
BUYFLOW_EVENTMIND_V11_RUNTIME_URL=http://127.0.0.1:4394/v1/eventmind
BUYFLOW_EVENTMIND_V11_ADAPTER_SHA256=
BUYFLOW_EVENTMIND_V11_TIMEOUT_MS=8000

# Modern immutable source archive. Keep false until the private bucket and additive
# source_emails migration are deployed. This never grants Purchase/Identity authority.
BUYFLOW_EMAIL_SOURCE_ARCHIVE_ENABLED=false
BUYFLOW_EMAIL_SOURCE_ARCHIVE_BUCKET=buyflow-email-source-v1

# Optional Mailgun -> source_emails/archive persistence. This is a second gate and
# is effective only when BUYFLOW_EMAIL_SOURCE_ARCHIVE_ENABLED is also true.
# Default Mailgun behavior remains read-only shadow evaluation.
BUYFLOW_MAILGUN_SOURCE_PERSIST_ENABLED=false

# Direct Gmail OAuth/runtime. Keep false until Google OAuth + Pub/Sub + the additive
# credentials/sync-state migrations are deployed and a controlled shadow smoke is green.
BUYFLOW_GMAIL_DIRECT_RUNTIME_ENABLED=false
GOOGLE_GMAIL_OAUTH_CLIENT_ID=
GOOGLE_GMAIL_OAUTH_CLIENT_SECRET=
GOOGLE_GMAIL_PUBSUB_TOPIC=
# Exact HTTPS push endpoint audience configured on the Pub/Sub push subscription.
GOOGLE_GMAIL_PUBSUB_AUDIENCE=
# Exact Google service account whose OIDC identity may invoke the push endpoint.
GOOGLE_GMAIL_PUBSUB_SERVICE_ACCOUNT_EMAIL=
# Base64-encoded 32-byte AES key. Keep only in server secret management; never commit a real value.
BUYFLOW_EMAIL_CREDENTIALS_KEY_BASE64=
# Direct Gmail intentionally does not rely on category:purchases; downstream commerce filtering decides relevance.
GMAIL_DIRECT_DISCOVERY_QUERY=newer_than:30d -in:spam -in:trash

# Controlled direct-Gmail shadow smoke. The smoke reads Gmail + RAW MIME and history
# but deliberately does not persist source emails, archive bytes or commit a cursor.
BUYFLOW_GMAIL_SHADOW_SMOKE_LIMIT=10
BUYFLOW_SMOKE_USER_ID=
BUYFLOW_SMOKE_CONNECTION_ID=

# Legacy/Nylas query retained for backwards compatibility.
EMAIL_DISCOVERY_QUERY=category:purchases newer_than:30d -in:spam -in:trash
